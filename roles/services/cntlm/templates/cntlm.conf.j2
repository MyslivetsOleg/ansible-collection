# /etc/cntlm.conf
# Управляется через Ansible (роль: cntlm). Не редактировать вручную.

# ------------------------------------------------------------
# Аутентификация
# ------------------------------------------------------------
Username        {{ cntlm_username }}
Domain          {{ cntlm_domain }}
PassNTLMv2      {{ cntlm_ntlm_hash }}

# ------------------------------------------------------------
# Upstream-прокси (перечислены в порядке приоритета)
# ------------------------------------------------------------
{% for proxy in cntlm_proxy_list %}
Proxy           {{ proxy }}
{% endfor %}

# ------------------------------------------------------------
# Локальный сервер
# ------------------------------------------------------------
Listen          {{ cntlm_listen_address }}:{{ cntlm_listen_port }}

# ------------------------------------------------------------
# Производительность и таймауты
# ------------------------------------------------------------

{% if cntlm_dns_ttl > 0 %}
# Время жизни DNS-кэша (секунды)
DnsTtl          {{ cntlm_dns_ttl }}
{% endif %}
