# /etc/systemd/system/cntlm.service
# Управляется через Ansible (роль: cntlm). Не редактировать вручную.

[Unit]
Description=CNTLM - NTLM/NTLMv2 authenticating HTTP proxy
Documentation=man:cntlm(1)
After=network.target
Wants=network.target

[Service]
Type=simple
User={{ cntlm_service_user }}
Group={{ cntlm_service_group }}

ExecStart={{ cntlm_bin_path }} -c {{ cntlm_conf_path }} -f
ExecReload=/bin/kill -HUP $MAINPID
ExecStop=/bin/kill -TERM $MAINPID

# Перезапускать при падении, но не при ручном systemctl stop
Restart=on-failure
RestartSec=5s

# Ограничения безопасности
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes

StandardOutput=journal
StandardError=journal
SyslogIdentifier=cntlm

[Install]
WantedBy=multi-user.target
