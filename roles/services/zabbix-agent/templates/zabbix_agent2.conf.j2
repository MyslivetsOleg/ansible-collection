# Zabbix Agent 2 configuration file for Debian 12
# Generated by Ansible

PidFile=/var/run/zabbix/zabbix_agent2.pid
LogFile=/var/log/zabbix/zabbix_agent2.log
LogFileSize=0

Server={{ zabbix_server }}
ListenPort=10050
ListenIP=0.0.0.0

Hostname={{ zabbix_hostname }}

TLSConnect={{ zabbix_tls_connect }}
TLSAccept={{ zabbix_tls_accept }}
TLSCAFile={{ zabbix_tls_ca_file }}
TLSCertFile={{ zabbix_tls_cert_file }}
TLSKeyFile={{ zabbix_tls_key_file }}
TLSPSKFile={{ zabbix_tls_psk_file }}
TLSPSKIdentity={{ zabbix_tls_psk_identity }}

DebugLevel={{ zabbix_log_level }}

Include=/etc/zabbix/zabbix_agent2.d/*.conf